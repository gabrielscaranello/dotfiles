{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": {
        "action": "sendInput",
        "input": "\u001b\r"
      },
      "id": "User.SendShiftEnter"
    }
  ],
  "alwaysShowTabs": false,
  "copyOnSelect": false,
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "keybindings": [
    {
      "id": "Terminal.DuplicateTab",
      "keys": "ctrl+shift+t"
    },
    {
      "id": "Terminal.NextTab",
      "keys": "ctrl+period"
    },
    {
      "id": "Terminal.PrevTab",
      "keys": "ctrl+comma"
    },
    {
      "id": "User.SendShiftEnter",
      "keys": "shift+enter"
    }
  ],
  "newTabMenu": [
    {
      "type": "remainingProfiles"
    }
  ],
  "profiles": {
    "defaults": {
      "bellStyle": "none",
      "colorScheme": "Tokyo Night",
      "cursorShape": "bar",
      "font": {
        "face": "JetBrainsMono Nerd Font",
        "size": 14
      },
      "opacity": 97
    },
    "list": [
      {
        "commandline": "wsl.exe -d Debian",
        "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
        "icon": "\ud83c\udf00",
        "name": "Debian",
        "startingDirectory": "~"
      },
      {
        "commandline": "powershell.exe",
        "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
        "name": "PowerShell"
      },
      {
        "commandline": "cmd.exe",
        "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
        "name": "Prompt de Comando"
      }
    ]
  },
  "schemes": [
    {
      "background": "#1A1B26",
      "black": "#15161E",
      "blue": "#7AA2F7",
      "brightBlack": "#414868",
      "brightBlue": "#8DB0FF",
      "brightCyan": "#A4DAFF",
      "brightGreen": "#9FE044",
      "brightPurple": "#C7A9FF",
      "brightRed": "#FF899D",
      "brightWhite": "#C0CAF5",
      "brightYellow": "#FABA4A",
      "cursorColor": "#C0CAF5",
      "cyan": "#7DCFFF",
      "foreground": "#C0CAF5",
      "green": "#9ECE6A",
      "name": "Tokyo Night",
      "purple": "#BB9AF7",
      "red": "#F7768E",
      "selectionBackground": "#283457",
      "white": "#A9B1D6",
      "yellow": "#E0AF68"
    }
  ],
  "showTabsInTitlebar": true,
  "theme": "Tokyo Night",
  "themes": [
    {
      "name": "Tokyo Night",
      "tab": {
        "background": "#7AA2F7FF",
        "iconStyle": "default",
        "showCloseButton": "always",
        "unfocusedBackground": "#292E42FF"
      },
      "tabRow": {
        "background": "#15161EFF",
        "unfocusedBackground": "#15161EFF"
      },
      "window": {
        "applicationTheme": "dark",
        "experimental.rainbowFrame": false,
        "frame": null,
        "unfocusedFrame": null,
        "useMica": false
      }
    }
  ]
}
